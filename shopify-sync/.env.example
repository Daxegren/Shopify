# --- Shopify ---------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=din-butik.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Antingen en Admin API-token ...
SHOPIFY_ACCESS_TOKEN=
# ... eller klient-id/hemlighet för en app i Shopify Dev Dashboard (client credentials).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Vad som synkas ----------------------------------------------------------
SINKS=bigquery,postgres
ENTITIES=orders,products,customers
SYNC_START_DATE=2018-01-01
SYNC_OVERLAP_MINUTES=15
BATCH_SIZE=5000

# --- BigQuery ---------------------------------------------------------------
BQ_PROJECT=ditt-gcp-projekt
BQ_DATASET=shopify
BQ_LOCATION=EU

# --- Supabase / Postgres ----------------------------------------------------
# Använd Supavisor-poolern (IPv4), session mode port 5432.
SUPABASE_DB_URL=postgresql://postgres.<projekt-ref>:<lösenord>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
PG_SCHEMA=shopify
