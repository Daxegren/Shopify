        },
        {
          "value": "hover",
          "label": "Magnify on hover"
        },
        {
          "value": "lightbox",
          "label": "Open lightbox"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox_mobile",
